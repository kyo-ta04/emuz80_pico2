.define IORQ_Pin 24
.define RD_Pin   25
.define WR_Pin   26
.define WAIT_Pin 27
.define D0_Pin   16

; SET pin 0 should be mapped to your LED GPIO

;   IN: A0-A15(0), IN_COUNT: 16
;   OUT: D0-Pin(16), OUT_COUNT: 8(D0-D7)
;   MOV: D0-Pin(16), OUT_COUNT: 8
;   JMP_PIN: IORQ_Pin(24)
;   RD_Pin(16), count: 1
.program ram_read_addr
.wrap_target
loop_1:
    wait 0 gpio RD_Pin; wait for IORQ==High && RD==Low
    jmp pin do_1
    jmp skip_1
do_1:
    in pins, 16         ; capture A0-A15
    push                ; 32 bit is specified in in-shift,
                        ; so explicit push is needed. 
    ;mov pindirs, ~null  ; D0-D7 as output
    ;pull
    ;out pins, 8         ; output DMA CH2 data to D0-D7
skip_1:
    wait 1 gpio RD_Pin
    mov pindirs, null
.wrap

;
; PIO0:SM1 ... ram_write_addr
;   IN: A0-A15(0), IN_COUNT: 16, autopush
;   MOV: D0-Pin(16), OUT_COUNT: 8
;   JMP: IORQ_Pin
;
.program ram_write_addr
.wrap_target
loop_2:
    wait 0 gpio WR_Pin ; wait for IORQ==High && WR==Low
    jmp pin do_2
    jmp skip_2
do_2:
    mov pindirs, null   ; D0-D7 as input
    in pins, 16
    push
skip_2:
    wait 1 gpio WR_Pin
.wrap

;
; PIO0:SM2: ram_write_data
;   IN:  D0_Pin(16), count: 8, no-autopush
.program ram_write_data
.wrap_target
loop_3:
    wait 0 gpio WR_Pin [4]
    jmp pin do_3
    jmp skip_3
do_3:
    in pins, 8
    push
    wait 1 gpio WR_Pin  ; wait for WR upper edge
    jmp loop_3
skip_3:
    wait 1 gpio WR_Pin  ; wait for WR upper edge
.wrap

; PIO0:SM3 ... data_out
;   OUT: D0-Pin(16), OUT_COUNT: 8(D0-D7)
.program data_out
.wrap_target
loop_1:
    wait 0 gpio RD_Pin ; wait RD==Low
    mov pindirs, ~null  ; D0-D7 as output
    pull
    out pins, 8         ; output DMA CH3 data to D0-D7
    wait 1 gpio RD_Pin
    mov pindirs, null
.wrap

;
; PIO1:SM2 ... two/one phase clock generator(program clockgen)
;
; SET: BASE: 29(CLK_Pin, inverted), 41(INT_Pin, inverted)
.program clockgen
.wrap_target
    ; outputs are inverted, so 0 means High, 1 means Low
    set pins, 1  ; Turn LED on
    set pins, 0  ; Turn LED off
; revive the following two lines if 2-phase clock feature we use
    ;set pins, 2
    ;set pins, 3
.wrap             ; Blink forever!

;
;

;
; PIO1:SM3: iorq_wait
;   SET: WAIT_Pin(27), count: 1
.program iorq_wait
    set pins, 1
.wrap_target
    wait 0 gpio IORQ_Pin     ; IORQ_Pin(24)
    set pins, 0         ; WAIT_PIn(27) Low
    pull                ; wait for MainCPU work done
    set pins, 1         ; WAIT_Pin(27) High
    wait 1 gpio IORQ_Pin     ; IORQ_Pin(24)
    push
.wrap

